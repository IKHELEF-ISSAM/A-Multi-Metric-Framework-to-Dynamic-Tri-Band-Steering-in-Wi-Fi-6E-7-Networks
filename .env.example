# Copy to .env in the repository root. Never commit .env or private SSH keys.
# Connect manually once and verify the AP host key before using the tools.
BPI_SSH_HOST=192.0.2.1
BPI_SSH_USER=root
BPI_SSH_PORT=22
BPI_SSH_KEY=
BPI_SSH_TIMEOUT=15
BPI_ALLOW_CHANGES=false

AP1_NAME=OpenWrt-AP
AP1_DEVICE_ID=ap1
AP1_CONTROL_DEVICE_ID=ap1
AP1_RADIO_2G_IFACE=phy0.0-ap0
AP1_RADIO_2G_UCI=radio0
AP1_RADIO_5G_IFACE=phy0.1-ap0
AP1_RADIO_5G_UCI=radio1
AP1_RADIO_6G_IFACE=phy0.2-ap0
AP1_RADIO_6G_UCI=radio2

# Run commands from the repository root; these are shared by API and CLI.
OPENWRT_DB_PATH=./rssi_lb.sqlite3
OPENWRT_DEVICE_RULES_PATH=./device_rules.json
DEVICE_RULES_FILE=./device_rules.json
STEERING_STATE_FILE=./steering_state.json
OPENWRT_POLL_INTERVAL=5
OPENWRT_TARGET_SSID=
STEERING_DURATION=600
STEERING_INTERVAL=5

# These defaults are configurable; per-device JSON rules can override them.
OPENWRT_DEFAULT_MIN_RSSI_2G=-65
OPENWRT_DEFAULT_MIN_RSSI_5G=-60
OPENWRT_DEFAULT_MIN_RSSI_6G=-55
OPENWRT_DEFAULT_MIN_THROUGHPUT_MBPS=20
OPENWRT_DEFAULT_MAX_AIRTIME_PERCENT=80
OPENWRT_DEFAULT_SWITCH_THRESHOLD=10
OPENWRT_DEFAULT_RULE_COOLDOWN=180
OPENWRT_CONTROL_COOLDOWN=60
OPENWRT_WEIGHT_CLIENTS=0.30
OPENWRT_WEIGHT_RSSI=0.20
OPENWRT_WEIGHT_AIRTIME=0.25
OPENWRT_WEIGHT_THROUGHPUT=0.15
OPENWRT_WEIGHT_TXPOWER=0.10
OPENWRT_TXPOWER_STEP=3
OPENWRT_MIN_TXPOWER=8
OPENWRT_MAX_TXPOWER=23

API_HOST=127.0.0.1
API_PORT=3001
